# Base path used by the real backend requests.
VITE_API_BASE_URL=/api

# When "true" the app serves a fully in-browser mock backend.
# Set to "false" to talk to the FastAPI backend through the Vite proxy.
VITE_USE_MOCK=true

# Dev-server proxy target for /api when VITE_USE_MOCK=false.
VITE_API_PROXY_TARGET=http://localhost:8000
