# Copy to .env and adjust. Never commit real credentials.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aladdin_poc
GENERATED_DIR=
MAX_REPAIR_ATTEMPTS=3
MONGO_TIMEOUT_MS=5000
# Build/test runner battery (Backend Plan §10). Defaults keep the pipeline
# hermetic (no network, no Node.js required).
TESTER_RUN_PIP_INSTALL=false
TESTER_RUN_PYTEST=true
TESTER_RUN_NPM_BUILD=false
# LLM-backed agents (DeepSeek, OpenAI-compatible). Set LLM_ENABLED=true only
# with a real key; never commit the key. Note: backend/.env is NOT auto-loaded
# - export these in the shell or put them in the VM's runtime.env.
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=8192
# Thinking is disabled for the structured agents: deepseek-flash otherwise
# reasons without bound and can exhaust max_tokens before emitting content.
# Set LLM_THINKING=enabled (with LLM_REASONING_EFFORT) for open-ended chat.
LLM_THINKING=disabled
LLM_REASONING_EFFORT=low
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
