# Public entry point for both environments and for PoC previews.
#
# Caddy owns the internet-facing ports and terminates TLS; everything behind
# it binds loopback only and is reached over 127.0.0.1. Certificates are
# obtained and renewed automatically from Let's Encrypt, and port 80 serves
# the HTTP -> HTTPS redirect and ACME challenges.
#
# No authentication: the site is open so anyone can try it, and several people
# can use it at once. What keeps that tolerable is that generated code cannot
# reach the host — app/agents/llm.py restricts generated files to backend/ and
# frontend/, so deploy/ (the Dockerfiles and compose file) stays
# platform-owned, and a PoC runs in a container with no Docker socket and
# capped CPU and memory.

{
	email dom7hc@bosch.com
}

(perf) {
	# Caddy does not compress by default. Without this the platform shipped 363 kB
	# of uncompressed JavaScript to every visitor, which was painful on mobile.
	encode zstd gzip

	# Vite fingerprints asset filenames, so a given URL's bytes never change and
	# can be cached indefinitely. Without this every visit refetched them.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}

# Production.
n4s-aladdin.southeastasia.cloudapp.azure.com {
	import perf
	reverse_proxy 127.0.0.1:8081
}

# Development, same certificate, separate port.
n4s-aladdin.southeastasia.cloudapp.azure.com:8443 {
	import perf
	reverse_proxy 127.0.0.1:8080
}

# --- PoC preview slots ------------------------------------------------------
#
# One port per slot, not one path per slot: generated frontends call absolute
# /api/... paths (enforced by app/generation/contract.py), so a shared path
# prefix would send those calls to Aladdin's own API instead of the PoC's.
# A distinct origin per preview keeps absolute paths inside that preview.
#
# Public 900N -> loopback 820N, which is where preview/builder.py publishes
# slot N.

n4s-aladdin.southeastasia.cloudapp.azure.com:9001 {
	import perf
	reverse_proxy 127.0.0.1:8201
}

n4s-aladdin.southeastasia.cloudapp.azure.com:9002 {
	import perf
	reverse_proxy 127.0.0.1:8202
}

n4s-aladdin.southeastasia.cloudapp.azure.com:9003 {
	import perf
	reverse_proxy 127.0.0.1:8203
}

n4s-aladdin.southeastasia.cloudapp.azure.com:9004 {
	import perf
	reverse_proxy 127.0.0.1:8204
}

n4s-aladdin.southeastasia.cloudapp.azure.com:9005 {
	import perf
	reverse_proxy 127.0.0.1:8205
}

n4s-aladdin.southeastasia.cloudapp.azure.com:9006 {
	import perf
	reverse_proxy 127.0.0.1:8206
}
